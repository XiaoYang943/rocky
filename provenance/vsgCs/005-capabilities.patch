-double
-MapManipulator::setViewpointFrame(double time_s)
-{
-    if ( !_setVPStartTime.has_value() )
-    {
-        _setVPStartTime->set( time_s, Units::SECONDS );
-        return 0.0;
-    }
-    else
-    {
-        // Start point is the current manipulator center:
