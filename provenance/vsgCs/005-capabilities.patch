-            {
-                double t2 = 2.0*tp;
-                tp = 0.5*t2;
-            }
-            else
-            {
-                double t2 = 2.0*(tp-0.5);
-                tp = 0.5+(0.5*t2);
-            }
-
-            // the more smoothsteps you do, the more pronounced the fade-in/out effect
-            smoothStepInterp( tp );
-        }
-        else if ( t > 0.0 )
-        {
-            tp = smoothStepInterp( tp );
-        }
-
-        vsg::dvec3 newCenter =
-            _srs.isGeodetic()
-            ? nlerp(startWorld, endWorld, tp)
-            : lerp(startWorld, endWorld, tp);
