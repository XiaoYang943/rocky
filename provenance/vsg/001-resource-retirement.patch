+// 清理独占引用不依赖新上传到来；仍有宿主引用的条目保持有效。
+uint64_t TransferTask::DataToCopy::pruneOrphans()
+{
+    uint64_t removed = 0;
+    for (auto b = dataMap.begin(); b != dataMap.end();)
+    {
+        for (auto i = b->second.begin(); i != b->second.end();)
+        {
+            if (i->second->referenceCount() == 1) { i = b->second.erase(i); ++removed; }
+            else ++i;
+        }
+        if (b->second.empty()) b = dataMap.erase(b); else ++b;
+    }
+    for (auto i = imageInfoSet.begin(); i != imageInfoSet.end();)
+    {
+        if ((*i)->referenceCount() == 1) { i = imageInfoSet.erase(i); ++removed; }
+        else ++i;
+    }
+    return removed;
+}
+
+TransferTask::ResourceUsage TransferTask::releaseUnusedResources()
+{
+    std::scoped_lock<std::mutex> lock(_mutex);
+    ResourceUsage usage;
+    for (auto* data : {&_earlyDataToCopy, &_lateDataToCopy})
+    {
+        // 上一提交仍在使用资源时推迟回收；下一次维护继续轮询。
+        bool completed = true;
+        for (auto& frame : data->frames)
+        {
+            if (frame->waitOnFence && frame->fence)
+            {
+                if (frame->fence->status() != VK_SUCCESS) { completed = false; ++usage.pendingFrames; continue; }
+                frame->fence->resetFenceAndDependencies();
+                frame->waitOnFence = false;
+            }
+        }
+        if (completed) usage.orphanedEntries += data->pruneOrphans();
+        for (auto& frame : data->frames)
+        {
+            if (completed && !data->containsDataToTransfer() && frame->staging)
+            {
+                usage.releasedStagingBytes += frame->staging->size;
+                if (frame->transferCommandBuffer) frame->transferCommandBuffer->reset();
+                frame->staging = {};
+                frame->buffer_data = nullptr;
+                frame->copyRegions.clear();
+                frame->copyRegions.shrink_to_fit();
+            }
+            if (frame->staging) usage.stagingBytes += frame->staging->size;
+        }
+    }
+    return usage;
 }
 
