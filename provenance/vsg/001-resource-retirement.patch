+uint32_t DescriptorPools::releaseUnusedPools()
+{
+    uint32_t released = 0;
+    for (auto i = descriptorPools.begin(); i != descriptorPools.end();)
+    {
+        uint32_t availableSets = 0;
+        DescriptorPoolSizes sizes;
+        (*i)->available(availableSets, sizes);
+        if ((*i)->referenceCount() == 1 && availableSets == (*i)->maxSets)
+        {
+            released += (*i)->maxSets;
+            i = descriptorPools.erase(i);
+        }
+        else ++i;
+    }
+    if (descriptorPools.empty()) minimum_maxSets = 0;
+    return released;
 }
 
