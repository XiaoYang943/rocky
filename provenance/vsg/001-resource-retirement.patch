+CompileManager::ResourceUsage CompileManager::releaseUnusedResources()
+{
+    ResourceUsage usage;
+    auto traversals = compileTraversals->take_all();
+    // 任一统计分配抛异常时仍归还上下文，避免后续工作线程永久等待。
+    auto returnTraversals = [&traversals](CompileTraversals* queue) { queue->add(traversals.begin(), traversals.end()); };
+    std::unique_ptr<CompileTraversals, decltype(returnTraversals)> restore(compileTraversals.get(), returnTraversals);
+    if (traversals.size() != numCompileTraversals)
+    {
+        usage.busy = true;
+        return usage;
+    }
+    for (auto& traversal : traversals)
+        for (auto& context : traversal->contexts)
+            if (context->requiresWaitForCompletion)
+            {
+                if (!context->fence || context->fence->status() != VK_SUCCESS) { usage.busy = true; return usage; }
+                context->fence->resetFenceAndDependencies();
+                context->requiresWaitForCompletion = false;
+            }
+    std::set<MemoryBufferPools*> devices, staging;
+    std::set<DescriptorPools*> descriptors;
+    for (auto& traversal : traversals)
+    {
+        for (auto& context : traversal->contexts)
+        {
+            context->reset();
+            if (context->deviceMemoryBufferPools) devices.insert(context->deviceMemoryBufferPools);
+            if (context->stagingMemoryBufferPools) staging.insert(context->stagingMemoryBufferPools);
+            if (context->descriptorPools) descriptors.insert(context->descriptorPools);
+        }
+    }
+    for (auto* pools : descriptors) usage.releasedDescriptorSets += pools->releaseUnusedPools();
+    for (auto* pools : devices)
+    {
+        usage.releasedBytes += pools->releaseUnusedPools();
+        usage.deviceReservedBytes += pools->computeMemoryTotalReserved();
+        usage.deviceAvailableBytes += pools->computeMemoryTotalAvailable();
+    }
+    for (auto* pools : staging)
+    {
+        usage.releasedBytes += pools->releaseUnusedPools();
+        usage.stagingReservedBytes += pools->computeMemoryTotalReserved();
+        usage.stagingAvailableBytes += pools->computeMemoryTotalAvailable();
+    }
+    return usage;
 }
 
