-        std::max(imageCount,
-            capabilities.minImageCount); // Vulkan spec requires
-    // minImageCount to be 1 or greater
-    if (capabilities.maxImageCount > 0)
-        imageCount = std::min(
-            imageCount,
-            capabilities.maxImageCount); // Vulkan spec specifies 0 as being
-    // unlimited number of images
