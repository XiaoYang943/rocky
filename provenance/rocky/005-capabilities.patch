-    if (modifier & vsg::MODKEY_Shift)
-    {
-        io.AddKeyEvent(ImGuiMod_Shift, pressed);
-    }
-    if (modifier & vsg::MODKEY_Alt)
-    {
-        io.AddKeyEvent(ImGuiMod_Alt, pressed);
