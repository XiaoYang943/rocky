+bool
+MapManipulator::setCameraPose(const vsg::dvec3& eye, const vsg::dvec3& direction,
+    const vsg::dvec3& up, double range)
+{
+    if (!applyCameraPose(eye, direction, up, range))
+        return false;
+    _state.setVP0.reset();
+    _state.setVP1.reset();
+    clearEvents();
+    _thrown = false;
+    _delta.set(0.0, 0.0);
+    _throwDelta.set(0.0, 0.0);
+    _continuousDelta.set(0.0, 0.0);
+    return true;
+}
+
+bool
+MapManipulator::applyCameraPose(const vsg::dvec3& eye, const vsg::dvec3& direction,
+    const vsg::dvec3& up, double range)
+{
+    auto mapNode = getMapNode();
+    if (!mapNode || !_camera_weakptr.ref_ptr() || !std::isfinite(range) ||
+        range < settings.minDistance || range > settings.maxDistance)
+        return false;
+    for (unsigned i = 0; i < 3; ++i)
+        if (!std::isfinite(eye[i]) || !std::isfinite(direction[i]) || !std::isfinite(up[i]))
+            return false;
+    if (std::abs(vsg::length(direction) - 1.0) > 1e-6 ||
+        std::abs(vsg::length(up) - 1.0) > 1e-6 || std::abs(vsg::dot(direction, up)) > 1e-6)
+        return false;
+    const auto center = eye + direction * range;
+    if (mapNode->srs().isGeocentric() && vsg::length(center) < 1.0)
+        return false;
+    auto frame = mapNode->srs().topocentricToWorldMatrix(to_glm(center));
+    frame[3] = glm::dvec4(0.0, 0.0, 0.0, 1.0);
+    const auto forward = vsg::normalize(direction);
+    const auto right = vsg::normalize(vsg::cross(forward, up));
+    const auto screenUp = vsg::cross(right, forward);
+    const glm::dmat3 orientation(to_glm(right), to_glm(screenUp), -to_glm(forward));
+    // 将完整姿态转换为 target ENU 下的 rotation，保留 roll；输入状态由调用方管理。
+    const auto local = glm::normalize(glm::quat_cast(glm::transpose(glm::dmat3(frame)) * orientation));
+    _state.center = center;
+    _state.centerRotation = to_vsg(frame);
+    _state.localRotation = vsg::dquat(local.x, local.y, local.z, local.w);
+    _state.localPositionOffset = {};
+    _state.tetherRotation = {};
+    _state.distance = range;
+    updateCamera();
+    return true;
+}
