-    -S "$SOURCE_DIR" \
-    -B "$BUILD_DIR" \
-    -G "$GENERATOR" \
-    -DCMAKE_BUILD_TYPE=Release \
-    -DCMAKE_TOOLCHAIN_FILE="$VCPKG_TOOLCHAIN_FILE"
-
-echo "CMake configuration complete!"
