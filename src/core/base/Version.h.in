#define GEOSTUDIO_NATIVE_STR_NX(s) #s
#define GEOSTUDIO_NATIVE_STR(s) GEOSTUDIO_NATIVE_STR_NX(s)
#define GEOSTUDIO_NATIVE_COMPUTE_VERSION(major, minor, rev) ((major) * 10000 + (minor) * 100 + (rev))
#define GEOSTUDIO_NATIVE_VERSION_NUMBER GEOSTUDIO_NATIVE_COMPUTE_VERSION(GEOSTUDIO_NATIVE_VERSION_MAJOR, GEOSTUDIO_NATIVE_VERSION_MINOR, GEOSTUDIO_NATIVE_VERSION_REV)
#define GEOSTUDIO_NATIVE_VERSION_STRING GEOSTUDIO_NATIVE_STR(GEOSTUDIO_NATIVE_VERSION_MAJOR) "." GEOSTUDIO_NATIVE_STR(GEOSTUDIO_NATIVE_VERSION_MINOR) "." GEOSTUDIO_NATIVE_STR(GEOSTUDIO_NATIVE_VERSION_REV)

#define GEOSTUDIO_NATIVE_VERSION_BEFORE(major, minor, rev) (GEOSTUDIO_NATIVE_VERSION_NUMBER < GEOSTUDIO_NATIVE_COMPUTE_VERSION(major, minor, rev))
#define GEOSTUDIO_NATIVE_VERSION_AT_LEAST(major, minor, rev) (GEOSTUDIO_NATIVE_VERSION_NUMBER >= GEOSTUDIO_NATIVE_COMPUTE_VERSION(major, minor, rev))

