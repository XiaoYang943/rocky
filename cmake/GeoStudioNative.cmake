include(${PROJECT_SOURCE_DIR}/cmake/MsvcIncludes.cmake)
include(GNUInstallDirs)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
set(GEOSTUDIO_DEPENDENCIES "${PROJECT_SOURCE_DIR}/.deps" CACHE PATH "Pinned external dependency cache")
set(GEOSTUDIO_GENERATED_INCLUDE "${CMAKE_BINARY_DIR}/include")
option(GEOSTUDIO_BUILD_TESTS "Build offline code regression suites" OFF)
file(READ "${PROJECT_SOURCE_DIR}/dependencies.lock.json" GN_LOCK)
string(JSON GN_COUNT LENGTH "${GN_LOCK}" sources)
math(EXPR GN_LAST "${GN_COUNT} - 1")
foreach(INDEX RANGE ${GN_LAST})
    string(JSON NAME GET "${GN_LOCK}" sources ${INDEX} name)
    string(JSON DIRECTORY GET "${GN_LOCK}" sources ${INDEX} directory)
    set(GN_SOURCE_${NAME} "${GEOSTUDIO_DEPENDENCIES}/src/${DIRECTORY}")
endforeach()
find_package(vsg CONFIG REQUIRED)
find_package(nlohmann_json CONFIG REQUIRED)
find_package(fmt CONFIG REQUIRED)
include_directories(BEFORE SYSTEM "${GN_SOURCE_glm}")
set(SPDLOG_FMT_EXTERNAL ON CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_SHARED OFF CACHE BOOL "" FORCE)
set(SPDLOG_BUILD_EXAMPLE OFF CACHE BOOL "" FORCE)
set(SPDLOG_INSTALL ON CACHE BOOL "" FORCE)
add_subdirectory("${GN_SOURCE_spdlog}" spdlog EXCLUDE_FROM_ALL)
include(cmake/Capabilities.cmake)
include(cmake/capability-sources.cmake)
add_subdirectory(src/render/import)
add_subdirectory(cmake/cesium-adapter)
foreach(capability core data scene drivers streaming render runtime)
    add_subdirectory(src/${capability})
endforeach()
add_library(geostudio-native INTERFACE)
set_target_properties(geostudio-native PROPERTIES EXPORT_NAME Native)
target_link_libraries(geostudio-native INTERFACE geostudio-runtime)
add_library(GeoStudio::Native ALIAS geostudio-native)
# 为消费方暂留 target alias，源码已按能力重新归类。
add_library(GeoStudio::Globe ALIAS geostudio-runtime)
add_library(GeoStudio::IO ALIAS geostudio-import)
add_library(GeoStudio::Tiles3D ALIAS geostudio-runtime-tiles)
if(GEOSTUDIO_BUILD_TESTS)
    enable_testing()
    add_subdirectory(tests/globe)
    add_subdirectory(tests/capabilities)
endif()
install(TARGETS geostudio-native EXPORT GeoStudioNativeTargets)
install(DIRECTORY resources/ DESTINATION share/GeoStudioNative/resources)
include(CMakePackageConfigHelpers)
configure_package_config_file(cmake/GeoStudioNativeConfig.cmake.in "${CMAKE_BINARY_DIR}/GeoStudioNativeConfig.cmake" INSTALL_DESTINATION lib/cmake/GeoStudioNative)
write_basic_package_version_file("${CMAKE_BINARY_DIR}/GeoStudioNativeConfigVersion.cmake" VERSION ${PROJECT_VERSION} COMPATIBILITY SameMinorVersion)
install(EXPORT GeoStudioNativeTargets NAMESPACE GeoStudio:: DESTINATION lib/cmake/GeoStudioNative)
install(FILES "${CMAKE_BINARY_DIR}/GeoStudioNativeConfig.cmake" "${CMAKE_BINARY_DIR}/GeoStudioNativeConfigVersion.cmake" DESTINATION lib/cmake/GeoStudioNative)
install(FILES dependencies.lock.json DESTINATION share/GeoStudioNative)
install(DIRECTORY cmake/sdk/ DESTINATION lib/cmake/GeoStudioNative/dependencies)
include(cmake/InstallProvenance.cmake)
install(FILES LICENSE.txt DESTINATION share/GeoStudioNative/licenses/rocky)
install(FILES provenance/vsgCs/upstream/LICENSE.md DESTINATION share/GeoStudioNative/licenses/vsgCs)
install(FILES provenance/vsgXchange/upstream/LICENSE.md DESTINATION share/GeoStudioNative/licenses/vsgXchange)
