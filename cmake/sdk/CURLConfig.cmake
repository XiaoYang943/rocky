if(NOT TARGET CURL::libcurl)
  add_library(CURL::libcurl SHARED IMPORTED)
  set_target_properties(CURL::libcurl PROPERTIES IMPORTED_IMPLIB "${NG_GDAL_SDK}/lib/libcurl.lib" IMPORTED_LOCATION "${NG_GDAL_SDK}/bin/libcurl.dll" INTERFACE_INCLUDE_DIRECTORIES "${NG_GDAL_SDK}/include")
  set_target_properties(CURL::libcurl PROPERTIES IMPORTED_CONFIGURATIONS RELEASE IMPORTED_IMPLIB_RELEASE "${NG_GDAL_SDK}/lib/libcurl.lib" IMPORTED_LOCATION_RELEASE "${NG_GDAL_SDK}/bin/libcurl.dll")
endif()
if(NOT TARGET CURL::libcurl_shared)
  add_library(CURL::libcurl_shared ALIAS CURL::libcurl)
endif()
file(STRINGS "${NG_GDAL_SDK}/include/curl/curlver.h" NG_CURL_VERSION_LINE REGEX "^#define LIBCURL_VERSION \"")
string(REGEX REPLACE ".*\"([^\"]+)\".*" "\\1" CURL_VERSION "${NG_CURL_VERSION_LINE}")
set(CURL_FOUND TRUE)
