# 只安装当前来源身份和完整差异，历史研究资料保留在源码仓库。
file(READ "${PROJECT_SOURCE_DIR}/provenance/manifest.json" GN_PROVENANCE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/provenance/manifest.json")
install(FILES provenance/manifest.json DESTINATION share/GeoStudioNative/provenance)
string(JSON GN_SOURCE_COUNT LENGTH "${GN_PROVENANCE}" sources)
math(EXPR GN_SOURCE_LAST "${GN_SOURCE_COUNT} - 1")
foreach(INDEX RANGE ${GN_SOURCE_LAST})
    string(JSON NAME GET "${GN_PROVENANCE}" sources ${INDEX} name)
    string(JSON FILE_MAP GET "${GN_PROVENANCE}" sources ${INDEX} fileManifest)
    install(FILES "${FILE_MAP}" DESTINATION "share/GeoStudioNative/provenance/${NAME}")
    string(JSON PATCH_COUNT LENGTH "${GN_PROVENANCE}" sources ${INDEX} patches)
    if(PATCH_COUNT GREATER 0)
        math(EXPR PATCH_LAST "${PATCH_COUNT} - 1")
        foreach(PATCH_INDEX RANGE ${PATCH_LAST})
            string(JSON PATCH GET "${GN_PROVENANCE}" sources ${INDEX} patches ${PATCH_INDEX} path)
            install(FILES "provenance/${NAME}/${PATCH}" DESTINATION "share/GeoStudioNative/provenance/${NAME}")
        endforeach()
    endif()
endforeach()
