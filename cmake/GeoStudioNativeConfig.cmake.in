@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_GeoStudioNative_PREFIX_PATH "${CMAKE_PREFIX_PATH}")
list(PREPEND CMAKE_PREFIX_PATH "${CMAKE_CURRENT_LIST_DIR}/dependencies")
find_dependency(vsg CONFIG)
find_dependency(nlohmann_json CONFIG)
find_dependency(fmt CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(glm CONFIG)
find_dependency(EnTT CONFIG)
find_dependency(PROJ CONFIG)
find_dependency(GDAL MODULE)
find_dependency(CURL CONFIG)
find_dependency(imgui CONFIG)
if(UNIX)
    find_dependency(Threads)
endif()
set(CMAKE_PREFIX_PATH "${_GeoStudioNative_PREFIX_PATH}")
include("${CMAKE_CURRENT_LIST_DIR}/GeoStudioNativeTargets.cmake")
set(GeoStudioNative_RESOURCE_DIR "${PACKAGE_PREFIX_DIR}/share/GeoStudioNative/resources")
check_required_components(GeoStudioNative)
