# 使用固定原件的转换库，避免引入上游 Viewer、插件和示例工程。
set(GEOSTUDIO_OSG_ROOT "${PROJECT_SOURCE_DIR}/../../packages/osg/sdk/osg-3.6.5-windows-x64-msvc" CACHE PATH "Prepared OSG SDK")
set(OSG2VSG_SOURCE "${GN_SOURCE_osg2vsg}")
if(NOT EXISTS "${OSG2VSG_SOURCE}/src/osg2vsg/convert.cpp")
    message(FATAL_ERROR "Prepare OSGB dependencies explicitly with scripts/prepare-osgb.ps1")
endif()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${PROJECT_SOURCE_DIR}/scripts/verify-osgb.py"
    --dependencies "${GEOSTUDIO_DEPENDENCIES}" --osg "${GEOSTUDIO_OSG_ROOT}" --gdal "${NG_GDAL_SDK}"
    RESULT_VARIABLE GN_OSGB_IDENTITY)
if(NOT GN_OSGB_IDENTITY EQUAL 0)
    message(FATAL_ERROR "OSGB dependency verification failed; use scripts/prepare-osgb.ps1 explicitly")
endif()
foreach(component osg osgDB osgUtil osgTerrain OpenThreads)
    unset(GN_${component}_LIBRARY CACHE)
    unset(GN_${component}_LIBRARY)
    find_library(GN_${component}_LIBRARY NAMES ${component} PATHS "${GEOSTUDIO_OSG_ROOT}/lib" NO_DEFAULT_PATH NO_CACHE REQUIRED)
    list(APPEND GN_OSG_LIBRARIES "${GN_${component}_LIBRARY}")
endforeach()
set(GN_OSG2VSG_FILES BuildOptions ConvertToVsg GeometryUtils ImageUtils Optimize OSG SceneAnalysis SceneBuilder ShaderUtils convert)
foreach(source IN LISTS GN_OSG2VSG_FILES)
    list(APPEND GN_OSG2VSG_SOURCES "${OSG2VSG_SOURCE}/src/osg2vsg/${source}.cpp")
endforeach()
add_library(geostudio-osg2vsg STATIC ${GN_OSG2VSG_SOURCES})
target_include_directories(geostudio-osg2vsg PUBLIC "${OSG2VSG_SOURCE}/include" "${GEOSTUDIO_OSG_ROOT}/include")
target_link_libraries(geostudio-osg2vsg PUBLIC vsg::vsg ${GN_OSG_LIBRARIES})
target_compile_definitions(geostudio-osg2vsg PRIVATE NOMINMAX)
target_compile_options(geostudio-osg2vsg PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/bigobj>)
set_target_properties(geostudio-osg2vsg PROPERTIES POSITION_INDEPENDENT_CODE ON)
# 插件与 DLL 使用同一固定 SDK，安装后无需 OSG 开发环境。
file(GLOB GN_OSG_RUNTIME "${GEOSTUDIO_OSG_ROOT}/bin/*.dll")
file(COPY ${GN_OSG_RUNTIME} DESTINATION "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
if(NOT EXISTS "${GEOSTUDIO_OSG_ROOT}/bin/osgdb_osg.dll")
    message(FATAL_ERROR "OSG runtime is incomplete; run packages/osg/scripts/build-sdk.ps1 explicitly")
endif()
install(FILES ${GN_OSG_RUNTIME} DESTINATION bin)
install(FILES "${GEOSTUDIO_OSG_ROOT}/OSG-LICENSE.txt" "${GEOSTUDIO_OSG_ROOT}/sdk-manifest.json" DESTINATION share/GeoStudioNative/licenses/osg)
install(FILES "${PROJECT_SOURCE_DIR}/../../packages/osg/manifest.json" DESTINATION share/GeoStudioNative/licenses/osg RENAME source-manifest.json)
install(FILES "${OSG2VSG_SOURCE}/LICENSE.md" DESTINATION share/GeoStudioNative/licenses/osg2vsg)
