# 保持既有 feature 边界，生成 GeoStudio API 与 ABI 配置。
set(PROJECT_VERSION_ABI 62)
find_package(PROJ CONFIG REQUIRED)
find_package(glm CONFIG REQUIRED)
find_package(GDAL REQUIRED)
find_package(CURL CONFIG REQUIRED)
find_package(EnTT CONFIG REQUIRED)
find_package(Vulkan 1.3.261 REQUIRED)
set(GEOSTUDIO_NATIVE_MAX_NUMBER_OF_VIEWS 8 CACHE STRING "Maximum simultaneous Globe views")
if(NOT GEOSTUDIO_NATIVE_MAX_NUMBER_OF_VIEWS MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "GEOSTUDIO_NATIVE_MAX_NUMBER_OF_VIEWS must be a positive integer")
endif()
set(GEOSTUDIO_NATIVE_USE_UTF8_FILENAMES_ON_WINDOWS ON)
foreach(FEATURE GLM PROJ SPDLOG JSON CURL GDAL VSG VSGXCHANGE ENTT)
    set(GEOSTUDIO_NATIVE_HAS_${FEATURE} ON)
endforeach()
if(EXISTS "${GDAL_INCLUDE_DIR}/ogr_geocoding.h")
    set(GEOSTUDIO_NATIVE_HAS_GEOCODER ON)
endif()

set(GEOSTUDIO_PUBLIC_INCLUDE "${CMAKE_BINARY_DIR}/public-include")
file(READ "${PROJECT_SOURCE_DIR}/cmake/capability-headers.json" GN_HEADERS)
string(JSON GN_HEADER_COUNT LENGTH "${GN_HEADERS}")
math(EXPR GN_HEADER_LAST "${GN_HEADER_COUNT} - 1")
foreach(index RANGE ${GN_HEADER_LAST})
    string(JSON source GET "${GN_HEADERS}" ${index} path)
    string(JSON destination GET "${GN_HEADERS}" ${index} include)
    string(JSON public GET "${GN_HEADERS}" ${index} public)
    if(source MATCHES "^src/")
        configure_file("${PROJECT_SOURCE_DIR}/${source}" "${GEOSTUDIO_GENERATED_INCLUDE}/${destination}" COPYONLY)
        if(public)
            configure_file("${PROJECT_SOURCE_DIR}/${source}" "${GEOSTUDIO_PUBLIC_INCLUDE}/${destination}" COPYONLY)
            get_filename_component(include_directory "${destination}" DIRECTORY)
            install(FILES "${GEOSTUDIO_PUBLIC_INCLUDE}/${destination}" DESTINATION "include/${include_directory}")
        endif()
    endif()
endforeach()
configure_file("${PROJECT_SOURCE_DIR}/src/core/base/Version.h.in" "${GEOSTUDIO_GENERATED_INCLUDE}/geostudio/native/core/base/Version.h")
configure_file("${GEOSTUDIO_GENERATED_INCLUDE}/geostudio/native/core/base/Version.h" "${GEOSTUDIO_PUBLIC_INCLUDE}/geostudio/native/core/base/Version.h" COPYONLY)
configure_file("${PROJECT_SOURCE_DIR}/resources/globe/shaders/rocky.defines.h.glsl" "${GEOSTUDIO_GENERATED_INCLUDE}/geostudio/native/render/shaders/rocky.defines.h.glsl" COPYONLY)
configure_file("${PROJECT_SOURCE_DIR}/resources/globe/shaders/rocky.defines.h.glsl" "${GEOSTUDIO_PUBLIC_INCLUDE}/geostudio/native/render/shaders/rocky.defines.h.glsl" COPYONLY)
install(FILES "${GEOSTUDIO_PUBLIC_INCLUDE}/geostudio/native/core/base/Version.h" DESTINATION include/geostudio/native/core/base)
install(FILES "${GEOSTUDIO_PUBLIC_INCLUDE}/geostudio/native/render/shaders/rocky.defines.h.glsl" DESTINATION include/geostudio/native/render/shaders)

function(geostudio_capability name exported)
    add_library(geostudio-${name} STATIC ${ARGN})
    add_library(GeoStudio::${exported} ALIAS geostudio-${name})
    set_target_properties(geostudio-${name} PROPERTIES EXPORT_NAME ${exported} POSITION_INDEPENDENT_CODE ON)
    target_compile_definitions(geostudio-${name} PRIVATE GEOSTUDIO_NATIVE_BUILDING_SDK PUBLIC GEOSTUDIO_NATIVE_STATIC)
    target_compile_options(geostudio-${name} PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/permissive-> $<$<CXX_COMPILER_ID:MSVC>:/we4834> $<$<CXX_COMPILER_ID:MSVC>:/utf-8> $<$<CXX_COMPILER_ID:MSVC>:/bigobj>)
    target_include_directories(geostudio-${name} PUBLIC $<BUILD_INTERFACE:${GEOSTUDIO_GENERATED_INCLUDE}> $<INSTALL_INTERFACE:include>)
    target_link_libraries(geostudio-${name} PUBLIC glm::glm spdlog::spdlog PRIVATE PROJ::proj GDAL::GDAL CURL::libcurl nlohmann_json::nlohmann_json)
    if(NOT name STREQUAL "core" AND NOT name STREQUAL "data")
        target_link_libraries(geostudio-${name} PUBLIC EnTT::EnTT vsg::vsg)
    endif()
    install(TARGETS geostudio-${name} EXPORT GeoStudioNativeTargets ARCHIVE DESTINATION lib)
endfunction()
